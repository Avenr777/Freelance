<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freelance.controller.WorkLogDialogController"
      spacing="16" prefWidth="440" stylesheets="@/css/ledger.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Log Work Hours" styleClass="ledger-header"/>

    <VBox spacing="6">
        <Label text="Select Project *" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="projectComboBox" promptText="Select a project..." maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Work Date *" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="workDatePicker" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Hours Worked *" style="-fx-font-weight: bold;"/>
        <TextField fx:id="hoursWorkedField" promptText="e.g. 3.5"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Description / Task Notes" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="descriptionArea" promptText="What was completed during this log..." prefRowCount="3"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="Save Work Log" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
