<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freelance.controller.ClientDialogController"
      spacing="16" prefWidth="400" stylesheets="@/css/ledger.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Add New Client" styleClass="ledger-header"/>

    <VBox spacing="6">
        <Label text="Client Name *" style="-fx-font-weight: bold;"/>
        <TextField fx:id="nameField" promptText="e.g. Acme Corp"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Email Address" style="-fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="billing@acme.com"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Phone Number" style="-fx-font-weight: bold;"/>
        <TextField fx:id="phoneField" promptText="+91 98765 43210"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="Save Client" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
